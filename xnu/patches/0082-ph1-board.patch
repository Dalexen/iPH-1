diff --git a/osfmk/arm64/sweet_board.h b/osfmk/arm64/sweet_board.h
new file mode 100644
index 0000000..16205b8
--- /dev/null
+++ b/osfmk/arm64/sweet_board.h
@@ -0,0 +1,38 @@
+/*
+ * Essential PH-1 (MSM8998) board constants shared by the early boot code.
+ * The bootloader splash framebuffer address is the one value that was taken
+ * from the msm8998 reference device trees and not from a PH-1; override it
+ * with PH1_FB_PHYS (see xnu/patches/0082-stage-board.sh).
+ */
+#ifndef _ARM64_SWEET_BOARD_H_
+#define _ARM64_SWEET_BOARD_H_
+
+#if __has_include(<arm64/ph1_fb_override.h>)
+#include <arm64/ph1_fb_override.h>
+#endif
+#ifndef PH1_FB_PHYS
+#define PH1_FB_PHYS         0x9d400000
+#endif
+
+#define SWEET_FB_PHYS       PH1_FB_PHYS
+#define SWEET_FB_W          1312
+#define SWEET_FB_H          2560
+#define SWEET_FB_STRIDE     5248        /* W * 4, a8r8g8b8 */
+
+/*
+ * 32 MB L2 blocks (16K pages) the framebuffer touches: its offset inside
+ * the first block plus its size, rounded up. 13.4 MB at 0x9d400000 spills
+ * into a second block.
+ */
+#define SWEET_FB_BLOCKS \
+    (((((SWEET_FB_PHYS) & 0x1ffffff) + SWEET_FB_W * SWEET_FB_H * 4) + 0x1ffffff) >> 25)
+
+/*
+ * MPIDR is Aff1 = cluster, Aff0 = core. Kryo 280 little cores (Cortex-A53
+ * class) have no 16K translation granule, the big cores (Cortex-A73 class)
+ * do, so the shim moves the boot over to the first big core and the ADT
+ * lists only 0x100-0x103. 0x0-0x3 are accepted for the QEMU virt tree.
+ */
+#define SWEET_MPIDR_VALID(id) (((id) & ~0x103u) == 0)
+
+#endif
